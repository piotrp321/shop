# Local Compose profile. Copy to `.env` (gitignored) to override defaults, e.g. to run
# several stacks side by side from different worktrees. Every variable is optional.
# Secrets do NOT belong here: they are generated into `.env.local` by `make up`.

# Compose project name (prefix of containers and volumes).
#COMPOSE_PROJECT_NAME=shop

# Host ports (browser access).
#STORE_PORT=3000
#ADMIN_PORT=5173
#API_PORT=8000
#KEYCLOAK_PORT=8080
#IMGPROXY_PORT=8081
#MAILPIT_PORT=8025
#RABBITMQ_MANAGEMENT_PORT=15672
