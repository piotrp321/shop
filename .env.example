# Local Compose profile. Copy to `.env` (gitignored) to override defaults, e.g. to run
# several stacks side by side from different worktrees. Every variable is optional.
# Secrets do NOT belong here: they are generated into `.env.local` by `make up`.

# Compose project name (prefix of containers and volumes). Defaults to the directory name.
#COMPOSE_PROJECT_NAME=shop-ws

# Host ports (browser access).
#STORE_PORT=3000
#ADMIN_PORT=5173
#API_PORT=8000
#KEYCLOAK_PORT=8080
#IMGPROXY_PORT=8081
#MAILPIT_PORT=8025
#RABBITMQ_MANAGEMENT_PORT=15672

# Public addresses of the frontends, used by the API (CORS allows only ADMIN_URL; STORE_URL is for links).
# Compose sets them in the api container as http://localhost:${ADMIN_PORT} and http://localhost:${STORE_PORT},
# so changing the ports above is enough. A value set here is NOT read by compose; to override them,
# change the `environment` of the api service in infra/docker-compose.yml.
#ADMIN_URL=http://localhost:5173
#STORE_URL=http://localhost:3000
