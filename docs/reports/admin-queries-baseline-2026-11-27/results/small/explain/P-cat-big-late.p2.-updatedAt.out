-- category big-late (a big leaf whose names start at 19% of the alphabet; 49 products), page 2, sort -updatedAt
-- products in the subtree = 49
SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE (p.primary_category_id IN (SELECT c.id FROM catalog_category c WHERE c.path LIKE '/fb2be761-1a8c-5d94-9c3f-2917db623644/a2f9bd8c-5f9d-58ae-a2d8-645f1736acbb/ef462a66-fe55-50aa-99b1-36061187ca88/%') OR EXISTS (SELECT 1 FROM catalog_product_category pc WHERE pc.product_id = p.id AND pc.category_id IN (SELECT c.id FROM catalog_category c WHERE c.path LIKE '/fb2be761-1a8c-5d94-9c3f-2917db623644/a2f9bd8c-5f9d-58ae-a2d8-645f1736acbb/ef462a66-fe55-50aa-99b1-36061187ca88/%'))) AND (p.updated_at, p.id) < (CAST('2025-03-20 15:33:56+00' AS timestamptz), CAST('cc555527-8125-57d9-98e8-abbf31ae94ac' AS uuid)) ORDER BY p.updated_at DESC, p.id DESC LIMIT 26;

