-- category big-early (a big leaf whose names start at 4% of the alphabet; 47 products), page 2, sort -updatedAt
-- products in the subtree = 47
SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE (p.primary_category_id IN (SELECT c.id FROM catalog_category c WHERE c.path LIKE '/d7c098d0-4bae-595e-a1e1-e4a923448956/f6f867f6-b41b-5131-9b4d-8a30fbea6c2b/4744a6a8-69df-52c4-8142-b3d5c2024a00/%') OR EXISTS (SELECT 1 FROM catalog_product_category pc WHERE pc.product_id = p.id AND pc.category_id IN (SELECT c.id FROM catalog_category c WHERE c.path LIKE '/d7c098d0-4bae-595e-a1e1-e4a923448956/f6f867f6-b41b-5131-9b4d-8a30fbea6c2b/4744a6a8-69df-52c4-8142-b3d5c2024a00/%'))) AND (p.updated_at, p.id) < (CAST('2025-08-30 21:49:18+00' AS timestamptz), CAST('8d8fc768-cee8-5689-be90-a7f79c19052a' AS uuid)) ORDER BY p.updated_at DESC, p.id DESC LIMIT 26;

