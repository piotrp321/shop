-- orders, a page in the middle of the dates
-- page = 25
SELECT o.id, o.number, o.placed_at, o.status, o.email, o.full_name, o.total_gross, o.currency, (SELECT COALESCE(SUM(l.quantity), 0) FROM ordering_order_line l WHERE l.order_id = o.id) AS item_count, o.refund_amount, o.refund_due_at, o.refund_completed_at FROM ordering_order o WHERE (o.placed_at, o.id) < (CAST('2025-10-01 18:32:58+00' AS timestamptz), CAST('0199a10c-8b90-72e2-9086-91e4e50ee246' AS uuid)) ORDER BY o.placed_at DESC, o.id DESC LIMIT 26;

