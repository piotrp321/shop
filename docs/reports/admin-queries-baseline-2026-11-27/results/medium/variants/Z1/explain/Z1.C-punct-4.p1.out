SELECT c.customer_id, c.email, c.full_name, c.order_count, c.paid_gross, c.last_order_at, lower(c.full_name) AS sort_name FROM ordering_customer c WHERE ((perf_bigrams(lower(c.email)) @> perf_bigrams(lower('ab-cd')) AND lower(c.email) LIKE '%' || lower('ab-cd') || '%') OR (perf_bigrams(lower(c.full_name)) @> perf_bigrams(lower('ab-cd')) AND lower(c.full_name) LIKE '%' || lower('ab-cd') || '%')) ORDER BY c.last_order_at DESC, c.customer_id LIMIT 26;

