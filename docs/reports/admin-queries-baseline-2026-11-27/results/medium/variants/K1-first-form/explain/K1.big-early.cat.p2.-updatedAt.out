-- category big-early (15199 products), page 2, sort -updatedAt
-- products in the subtree = 15199
SELECT DISTINCT ON (updated_at, id) id, name, tax_class, updated_at FROM ((SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.primary_category_id = '22652b43-0274-5fd4-b1b8-76cd4469ead0' AND (p.updated_at, p.id) < (CAST('2026-11-11 09:19:32+00' AS timestamptz), CAST('d08c7304-d537-50c2-9b35-5dd4c7998989' AS uuid)) ORDER BY p.updated_at DESC, p.id DESC LIMIT 26) UNION ALL (SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.id IN (SELECT product_id FROM catalog_product_category WHERE category_id = ANY('{22652b43-0274-5fd4-b1b8-76cd4469ead0}'::uuid[])) AND (p.updated_at, p.id) < (CAST('2026-11-11 09:19:32+00' AS timestamptz), CAST('d08c7304-d537-50c2-9b35-5dd4c7998989' AS uuid)) ORDER BY p.updated_at DESC, p.id DESC LIMIT 26)) u ORDER BY updated_at DESC, id DESC LIMIT 26;

