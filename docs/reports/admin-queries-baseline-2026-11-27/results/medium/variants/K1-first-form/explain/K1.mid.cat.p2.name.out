-- category mid (10585 products), page 2, sort name
-- products in the subtree = 10585
SELECT DISTINCT ON (name, id) id, name, tax_class, updated_at FROM ((SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.primary_category_id = 'c2a92470-bddd-5c3a-9b84-ed06bfd4caad' AND (p.name, p.id) > ('Buty na bieżnię Elkos Pustułka 900', CAST('e28cb68a-b4c3-5c37-8c2f-72ad52c2d90e' AS uuid)) ORDER BY p.name ASC, p.id ASC LIMIT 26) UNION ALL (SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.id IN (SELECT product_id FROM catalog_product_category WHERE category_id = ANY('{c2a92470-bddd-5c3a-9b84-ed06bfd4caad}'::uuid[])) AND (p.name, p.id) > ('Buty na bieżnię Elkos Pustułka 900', CAST('e28cb68a-b4c3-5c37-8c2f-72ad52c2d90e' AS uuid)) ORDER BY p.name ASC, p.id ASC LIMIT 26)) u ORDER BY name, id LIMIT 26;

