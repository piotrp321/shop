-- category big-late (22829 products), page 2, sort -updatedAt
-- products in the subtree = 22829
SELECT DISTINCT ON (updated_at, id) id, name, tax_class, updated_at FROM ((SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.primary_category_id = 'c65841c4-e5f5-58f5-9451-5e985cfec063' AND (p.updated_at, p.id) < (CAST('2026-11-12 04:46:13+00' AS timestamptz), CAST('affdd904-f20a-5809-960e-ae6986ef922b' AS uuid)) ORDER BY p.updated_at DESC, p.id DESC LIMIT 26) UNION ALL (SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.id IN (SELECT product_id FROM catalog_product_category WHERE category_id = ANY('{c65841c4-e5f5-58f5-9451-5e985cfec063}'::uuid[])) AND (p.updated_at, p.id) < (CAST('2026-11-12 04:46:13+00' AS timestamptz), CAST('affdd904-f20a-5809-960e-ae6986ef922b' AS uuid)) ORDER BY p.updated_at DESC, p.id DESC LIMIT 26)) u ORDER BY updated_at DESC, id DESC LIMIT 26;

