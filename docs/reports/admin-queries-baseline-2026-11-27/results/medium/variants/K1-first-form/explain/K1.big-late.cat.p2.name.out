-- category big-late (22829 products), page 2, sort name
-- products in the subtree = 22829
SELECT DISTINCT ON (name, id) id, name, tax_class, updated_at FROM ((SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.primary_category_id = 'c65841c4-e5f5-58f5-9451-5e985cfec063' AND (p.name, p.id) > ('Buty neoprenowe Corrovar Trawers 350 Plus', CAST('20a7b18f-6140-58a5-9ae6-aa762444c6ca' AS uuid)) ORDER BY p.name ASC, p.id ASC LIMIT 26) UNION ALL (SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.id IN (SELECT product_id FROM catalog_product_category WHERE category_id = ANY('{c65841c4-e5f5-58f5-9451-5e985cfec063}'::uuid[])) AND (p.name, p.id) > ('Buty neoprenowe Corrovar Trawers 350 Plus', CAST('20a7b18f-6140-58a5-9ae6-aa762444c6ca' AS uuid)) ORDER BY p.name ASC, p.id ASC LIMIT 26)) u ORDER BY name, id LIMIT 26;

