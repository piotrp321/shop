SELECT DISTINCT ON (updated_at, id) id, name, tax_class, updated_at FROM ((SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.primary_category_id = 'c57c017b-d6f7-5990-82bf-635533003629' AND (p.updated_at, p.id) < (CAST('2026-11-08 00:23:38+00' AS timestamptz), CAST('198bc48c-5196-5ced-b528-18064684dec2' AS uuid)) ORDER BY p.updated_at DESC, p.id DESC LIMIT 26) UNION ALL (SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.id IN (SELECT product_id FROM catalog_product_category WHERE category_id = ANY('{c57c017b-d6f7-5990-82bf-635533003629}'::uuid[])) AND (p.updated_at, p.id) < (CAST('2026-11-08 00:23:38+00' AS timestamptz), CAST('198bc48c-5196-5ced-b528-18064684dec2' AS uuid)) ORDER BY p.updated_at DESC, p.id DESC LIMIT 26)) u ORDER BY updated_at DESC, id DESC LIMIT 26;

