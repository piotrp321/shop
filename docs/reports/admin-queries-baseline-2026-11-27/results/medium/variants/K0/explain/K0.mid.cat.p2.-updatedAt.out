-- category mid (10585 products), page 2, sort -updatedAt
-- products in the subtree = 10585
SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.id IN (SELECT id FROM catalog_product WHERE primary_category_id IN (SELECT c.id FROM catalog_category c WHERE c.path LIKE '/492f4a2e-2d1b-5ea7-ae33-c0101cd720ea/b24e7921-99db-51d6-b6cf-382103f299df/c2a92470-bddd-5c3a-9b84-ed06bfd4caad/%') UNION SELECT product_id FROM catalog_product_category WHERE category_id IN (SELECT c.id FROM catalog_category c WHERE c.path LIKE '/492f4a2e-2d1b-5ea7-ae33-c0101cd720ea/b24e7921-99db-51d6-b6cf-382103f299df/c2a92470-bddd-5c3a-9b84-ed06bfd4caad/%')) AND (p.updated_at, p.id) < (CAST('2026-11-09 21:24:07+00' AS timestamptz), CAST('8700e4e3-d98b-5cd3-ad22-aae0fe0bc065' AS uuid)) ORDER BY p.updated_at DESC, p.id DESC LIMIT 26;

