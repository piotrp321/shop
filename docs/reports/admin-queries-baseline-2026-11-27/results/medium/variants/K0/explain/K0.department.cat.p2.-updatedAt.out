-- category department (206849 products), page 2, sort -updatedAt
-- products in the subtree = 206849
SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.id IN (SELECT id FROM catalog_product WHERE primary_category_id IN (SELECT c.id FROM catalog_category c WHERE c.path LIKE '/d7c098d0-4bae-595e-a1e1-e4a923448956/%') UNION SELECT product_id FROM catalog_product_category WHERE category_id IN (SELECT c.id FROM catalog_category c WHERE c.path LIKE '/d7c098d0-4bae-595e-a1e1-e4a923448956/%')) AND (p.updated_at, p.id) < (CAST('2026-11-27 12:59:11+00' AS timestamptz), CAST('874b932f-5196-5088-a9b2-ab5d518bb6ae' AS uuid)) ORDER BY p.updated_at DESC, p.id DESC LIMIT 26;

