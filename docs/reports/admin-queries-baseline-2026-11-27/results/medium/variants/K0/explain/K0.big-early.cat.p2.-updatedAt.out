-- category big-early (15199 products), page 2, sort -updatedAt
-- products in the subtree = 15199
SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.id IN (SELECT id FROM catalog_product WHERE primary_category_id IN (SELECT c.id FROM catalog_category c WHERE c.path LIKE '/d7c098d0-4bae-595e-a1e1-e4a923448956/a58050fa-627a-5c6f-aa94-3f392baa4385/22652b43-0274-5fd4-b1b8-76cd4469ead0/%') UNION SELECT product_id FROM catalog_product_category WHERE category_id IN (SELECT c.id FROM catalog_category c WHERE c.path LIKE '/d7c098d0-4bae-595e-a1e1-e4a923448956/a58050fa-627a-5c6f-aa94-3f392baa4385/22652b43-0274-5fd4-b1b8-76cd4469ead0/%')) AND (p.updated_at, p.id) < (CAST('2026-11-11 09:19:32+00' AS timestamptz), CAST('d08c7304-d537-50c2-9b35-5dd4c7998989' AS uuid)) ORDER BY p.updated_at DESC, p.id DESC LIMIT 26;

