-- category small + without images, count
-- products in the subtree = 15
SELECT count(*) FROM (SELECT 1 FROM catalog_product p WHERE p.id IN (SELECT id FROM catalog_product WHERE primary_category_id IN (SELECT c.id FROM catalog_category c WHERE c.path LIKE '/8c10569a-2f29-539a-b2ec-ae97f68410a7/592d133b-169f-5d84-b197-b877925beda1/d947db5c-6f5f-5457-94f2-4b487d81a22e/%') UNION SELECT product_id FROM catalog_product_category WHERE category_id IN (SELECT c.id FROM catalog_category c WHERE c.path LIKE '/8c10569a-2f29-539a-b2ec-ae97f68410a7/592d133b-169f-5d84-b197-b877925beda1/d947db5c-6f5f-5457-94f2-4b487d81a22e/%')) AND p.images = '[]'::jsonb LIMIT 10001) bounded;

