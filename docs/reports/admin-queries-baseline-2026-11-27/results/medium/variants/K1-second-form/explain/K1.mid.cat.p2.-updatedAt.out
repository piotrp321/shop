WITH additional AS MATERIALIZED (SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product_category pc JOIN catalog_product p ON p.id = pc.product_id WHERE pc.category_id = ANY('{c2a92470-bddd-5c3a-9b84-ed06bfd4caad}'::uuid[]) AND (p.updated_at, p.id) < (CAST('2026-11-09 21:24:07+00' AS timestamptz), CAST('8700e4e3-d98b-5cd3-ad22-aae0fe0bc065' AS uuid))) SELECT DISTINCT ON (updated_at, id) id, name, tax_class, updated_at FROM ((SELECT p.id, p.name, p.tax_class, p.updated_at FROM catalog_product p WHERE p.primary_category_id = 'c2a92470-bddd-5c3a-9b84-ed06bfd4caad' AND (p.updated_at, p.id) < (CAST('2026-11-09 21:24:07+00' AS timestamptz), CAST('8700e4e3-d98b-5cd3-ad22-aae0fe0bc065' AS uuid)) ORDER BY p.updated_at DESC, p.id DESC LIMIT 26) UNION ALL (SELECT id, name, tax_class, updated_at FROM additional ORDER BY updated_at DESC, id DESC LIMIT 26)) u ORDER BY updated_at DESC, id DESC LIMIT 26;

