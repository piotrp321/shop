{
  "name": "deploy-push",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/deploy"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {"actor_type": "DeployKey", "actor_id": null, "bypass_mode": "always"}
  ],
  "rules": [
    {"type": "creation"},
    {"type": "update"}
  ]
}
