{
    "openapi": "3.0.3",
    "info": {
        "title": "Shop Admin API",
        "description": "Endpoints used by the admin panel.",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/admin/dashboard": {
            "get": {
                "tags": [
                    "Staff"
                ],
                "summary": "Dashboard",
                "description": "Catalogue numbers for every staff member. The system status (services, outbox, queues, search index) only for administrators; for other roles `system` is null. A service that is down, a broker whose management API does not answer (`queues` is null) or a search index that cannot be counted (`indexedProducts` is null, `inSync` is false) does not fail the request.",
                "operationId": "getDashboard",
                "responses": {
                    "200": {
                        "description": "The dashboard.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DashboardResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid access token (problem details, `WWW-Authenticate: Bearer`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "The database is unavailable, or the keys of the token issuer cannot be fetched (problem details without detail).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "backoffice": []
                    }
                ]
            }
        },
        "/api/v1/admin/me": {
            "get": {
                "tags": [
                    "Staff"
                ],
                "summary": "Current staff member",
                "description": "The staff member identified by the access token of the `backoffice` realm, with any staff role.",
                "operationId": "getStaffMe",
                "responses": {
                    "200": {
                        "description": "The staff member.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StaffMeResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid access token (problem details, `WWW-Authenticate: Bearer`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "The keys of the token issuer cannot be fetched (problem details without detail).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "backoffice": []
                    }
                ]
            }
        },
        "/api/v1/admin/categories": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "summary": "Category tree",
                "description": "The whole category tree, for every staff member. Siblings at every level are sorted by name (Polish collation).",
                "operationId": "getBackofficeCategoryTree",
                "responses": {
                    "200": {
                        "description": "Root categories with their descendants. An empty catalogue gives an empty array.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryNode"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid access token (problem details, `WWW-Authenticate: Bearer`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "The keys of the token issuer cannot be fetched (problem details without detail).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "backoffice": []
                    }
                ]
            }
        },
        "/api/v1/admin/prices": {
            "get": {
                "tags": [
                    "Pricing"
                ],
                "summary": "Price list",
                "description": "A page of products sorted by name, then by id, each with its price (null when it has none). Every staff member may read it. Page with the opaque `next` cursor as `after`; the total is not counted. The category filter includes the subcategories and the products that have the category as an additional one; an unknown category gives 404. The search term is a literal part of the name, case-insensitive.",
                "operationId": "listPrices",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "description": "A part of the product name, 2 to 100 characters.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "maxLength": 100,
                            "minLength": 2
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "description": "Category id (UUID).",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "after",
                        "in": "query",
                        "description": "The `next` cursor of the previous page.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "maxLength": 2048,
                            "minLength": 1
                        }
                    },
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Page size.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 25,
                            "maximum": 100,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of the price list. Possibly an empty one.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PriceListResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid query parameters or paging cursor (problem details with `violations`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid access token (problem details, `WWW-Authenticate: Bearer`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The `category` filter names a category that does not exist (problem details).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "The keys of the token issuer cannot be fetched (problem details without detail).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "backoffice": []
                    }
                ]
            }
        },
        "/api/v1/admin/products/{productId}/price": {
            "put": {
                "tags": [
                    "Pricing"
                ],
                "summary": "Change the price of a product",
                "description": "Sets the gross price; the API computes the net and the VAT at the current rate of the price's tax class (the class of the product for a first price). Administrators only. Send the `version` of the price you saw (null for a product without a price): a price changed since then is a 409 and nothing is overwritten. The same gross at the same rate changes nothing: the version stays and no history entry is recorded. The history entry names the staff member of the token.",
                "operationId": "changePrice",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "description": "Product id (UUID).",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ChangePriceRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The price as saved, or as it was when nothing changed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ListedPriceResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The body is not valid JSON (problem details).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid access token (problem details, `WWW-Authenticate: Bearer`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The staff member is not an administrator (problem details).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No such product, or the id is not a UUID (problem details).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "The price was changed since the given version, or created since the null version (problem details). Reload it.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "415": {
                        "description": "The body is not JSON (problem details).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "The gross is out of range or a key is missing or of a wrong type (problem details with `violations`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "The keys of the token issuer cannot be fetched (problem details without detail).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "backoffice": []
                    }
                ]
            }
        },
        "/api/v1/admin/products/{productId}/price-history": {
            "get": {
                "tags": [
                    "Pricing"
                ],
                "summary": "Price history of a product",
                "description": "Every recorded change of the price of a product, newest first, with the price as it was set, what made the change and, for a change by staff, who. Every staff member may read it. A product that exists but never had a price has an empty history. Page with the opaque `next` cursor as `after`; the total is not counted.",
                "operationId": "getPriceHistory",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "description": "Product id (UUID).",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
                        }
                    },
                    {
                        "name": "after",
                        "in": "query",
                        "description": "The `next` cursor of the previous page.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "maxLength": 2048,
                            "minLength": 1
                        }
                    },
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Page size.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 25,
                            "maximum": 100,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of the history. Possibly an empty one.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PriceHistoryResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid query parameters or paging cursor (problem details with `violations`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid access token (problem details, `WWW-Authenticate: Bearer`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No such product, or the id is not a UUID (problem details).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "The keys of the token issuer cannot be fetched (problem details without detail).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "backoffice": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "Problem": {
                "description": "Problem details (RFC 9457), `application/problem+json`.",
                "required": [
                    "type",
                    "title",
                    "status"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "example": "about:blank"
                    },
                    "title": {
                        "type": "string",
                        "example": "Bad Request"
                    },
                    "status": {
                        "type": "integer",
                        "example": 400
                    },
                    "detail": {
                        "description": "Present only for 4xx errors, never for 5xx.",
                        "type": "string"
                    },
                    "violations": {
                        "description": "Present only for 400 (invalid query parameters) or 422 (invalid request body) caused by invalid input.",
                        "type": "array",
                        "items": {
                            "required": [
                                "propertyPath",
                                "title"
                            ],
                            "properties": {
                                "propertyPath": {
                                    "type": "string",
                                    "example": "category"
                                },
                                "title": {
                                    "type": "string",
                                    "example": "This is not a valid UUID."
                                }
                            },
                            "type": "object"
                        }
                    }
                },
                "type": "object"
            },
            "BackofficePricesQuery": {
                "properties": {
                    "q": {
                        "type": "string",
                        "pattern": "((?!\\0).)*",
                        "nullable": true,
                        "default": null,
                        "maxLength": 100,
                        "minLength": 2
                    },
                    "category": {
                        "type": "string",
                        "nullable": true,
                        "default": null
                    },
                    "after": {
                        "type": "string",
                        "nullable": true,
                        "default": null,
                        "maxLength": 2048,
                        "minLength": 1
                    },
                    "perPage": {
                        "type": "integer",
                        "default": 25,
                        "maximum": 100,
                        "minimum": 1
                    }
                },
                "type": "object"
            },
            "ChangePriceRequest": {
                "description": "A new gross price, based on the version of the price the staff member saw.",
                "required": [
                    "gross",
                    "version"
                ],
                "properties": {
                    "gross": {
                        "description": "Gross price (VAT included) in grosze, from 1 (0,01 z\u0142) to 99 999 999 (999 999,99 z\u0142).",
                        "type": "integer",
                        "example": 5990,
                        "maximum": 99999999,
                        "minimum": 1
                    },
                    "version": {
                        "description": "The `version` of the price the change is based on; null when the product has no price yet.",
                        "type": "integer",
                        "example": 1,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "PriceHistoryQuery": {
                "properties": {
                    "after": {
                        "type": "string",
                        "nullable": true,
                        "default": null,
                        "maxLength": 2048,
                        "minLength": 1
                    },
                    "perPage": {
                        "type": "integer",
                        "default": 25,
                        "maximum": 100,
                        "minimum": 1
                    }
                },
                "type": "object"
            },
            "DashboardCatalogResponse": {
                "description": "Catalogue numbers, from the database.",
                "required": [
                    "productCount",
                    "categoryCount",
                    "productsWithoutImages"
                ],
                "properties": {
                    "productCount": {
                        "type": "integer",
                        "example": 412
                    },
                    "categoryCount": {
                        "type": "integer",
                        "example": 36
                    },
                    "productsWithoutImages": {
                        "description": "Products with no image.",
                        "type": "integer",
                        "example": 8
                    }
                },
                "type": "object"
            },
            "DashboardServiceResponse": {
                "description": "The state of one service of the stack.",
                "required": [
                    "name",
                    "status",
                    "latencyMs"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "postgres"
                    },
                    "status": {
                        "type": "string",
                        "example": "up",
                        "enum": [
                            "up",
                            "down"
                        ]
                    },
                    "latencyMs": {
                        "description": "How long the service took to answer, in milliseconds. Null when it is down.",
                        "type": "integer",
                        "example": 3,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "DashboardOutboxResponse": {
                "description": "The outbox of domain events.",
                "required": [
                    "pending"
                ],
                "properties": {
                    "pending": {
                        "description": "Events waiting to be relayed to the broker.",
                        "type": "integer",
                        "example": 0
                    }
                },
                "type": "object"
            },
            "DashboardQueueResponse": {
                "description": "A queue of the message broker.",
                "required": [
                    "name",
                    "messages",
                    "consumers"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "events"
                    },
                    "messages": {
                        "description": "Messages in the queue.",
                        "type": "integer",
                        "example": 0
                    },
                    "consumers": {
                        "description": "Number of AMQP subscribers (basic.consume) of the queue, as reported by RabbitMQ. The Messenger worker polls with basic.get instead of subscribing, so this is 0 even while the worker runs: it says nothing about the worker.",
                        "type": "integer",
                        "example": 0
                    }
                },
                "type": "object"
            },
            "DashboardSearchIndexResponse": {
                "description": "The search index compared with the catalogue.",
                "required": [
                    "indexedProducts",
                    "catalogProducts",
                    "inSync"
                ],
                "properties": {
                    "indexedProducts": {
                        "description": "Documents in the index. Null when the index cannot be counted.",
                        "type": "integer",
                        "example": 412,
                        "nullable": true
                    },
                    "catalogProducts": {
                        "description": "Products in the database.",
                        "type": "integer",
                        "example": 412
                    },
                    "inSync": {
                        "description": "Whether both numbers are equal. False when the index cannot be counted.",
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "DashboardSystemResponse": {
                "description": "The state of the system, for administrators.",
                "required": [
                    "services",
                    "outbox",
                    "queues",
                    "searchIndex"
                ],
                "properties": {
                    "services": {
                        "description": "Always in this order: postgres, redis, elasticsearch, rabbitmq, keycloak, garage, imgproxy, mailpit. A service that does not answer within 1 s is down.",
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DashboardServiceResponse"
                        }
                    },
                    "outbox": {
                        "$ref": "#/components/schemas/DashboardOutboxResponse"
                    },
                    "queues": {
                        "description": "Queues of the broker. Null when its management API does not answer.",
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DashboardQueueResponse"
                        },
                        "nullable": true
                    },
                    "searchIndex": {
                        "$ref": "#/components/schemas/DashboardSearchIndexResponse"
                    }
                },
                "type": "object"
            },
            "DashboardResponse": {
                "description": "What the admin dashboard shows.",
                "required": [
                    "catalog",
                    "system"
                ],
                "properties": {
                    "catalog": {
                        "$ref": "#/components/schemas/DashboardCatalogResponse"
                    },
                    "system": {
                        "description": "Null unless the staff member is an administrator.",
                        "nullable": true,
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/DashboardSystemResponse"
                            }
                        ]
                    }
                },
                "type": "object"
            },
            "StaffMeResponse": {
                "description": "The staff member identified by the access token.",
                "required": [
                    "id",
                    "username",
                    "roles"
                ],
                "properties": {
                    "id": {
                        "description": "Staff member id, the `sub` of the token.",
                        "type": "string",
                        "example": "f05dcc92-3f9f-41ba-a905-5325ece4a239"
                    },
                    "username": {
                        "type": "string",
                        "example": "admin"
                    },
                    "roles": {
                        "description": "Staff roles, without any other realm role.",
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "admin",
                                "support",
                                "warehouse",
                                "marketing"
                            ]
                        },
                        "example": [
                            "admin"
                        ]
                    }
                },
                "type": "object"
            },
            "CategoryNode": {
                "required": [
                    "id",
                    "name",
                    "children"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "children": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CategoryNode"
                        }
                    }
                },
                "type": "object"
            },
            "ListedPriceResponse": {
                "description": "The stored price of a product. Amounts are in grosze, the rate in basis points; all computed by the API.",
                "required": [
                    "gross",
                    "net",
                    "vat",
                    "vatRate",
                    "currency",
                    "version",
                    "updatedAt",
                    "vatRateOutdated"
                ],
                "properties": {
                    "gross": {
                        "description": "Gross price (VAT included) in grosze.",
                        "type": "integer",
                        "example": 5490
                    },
                    "net": {
                        "description": "Net price in grosze.",
                        "type": "integer",
                        "example": 5229
                    },
                    "vat": {
                        "description": "VAT amount in grosze (gross minus net).",
                        "type": "integer",
                        "example": 261
                    },
                    "vatRate": {
                        "description": "The VAT rate the amounts were computed at, in basis points (2300 = 23%).",
                        "type": "integer",
                        "example": 500
                    },
                    "currency": {
                        "description": "ISO 4217 code.",
                        "type": "string",
                        "example": "PLN"
                    },
                    "version": {
                        "description": "Version of the price, for the optimistic locking of changes.",
                        "type": "integer",
                        "example": 1
                    },
                    "updatedAt": {
                        "description": "When the price last changed (RFC 3339).",
                        "type": "string",
                        "example": "2026-11-01T12:30:00+00:00"
                    },
                    "vatRateOutdated": {
                        "description": "The stored rate is no longer the rate of the price's tax class: the price is not offered in the store until it is repaired.",
                        "type": "boolean",
                        "example": false
                    }
                },
                "type": "object"
            },
            "PriceListItemResponse": {
                "description": "A product with its price.",
                "required": [
                    "productId",
                    "name",
                    "taxClass",
                    "applicableVatRate",
                    "price"
                ],
                "properties": {
                    "productId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string",
                        "example": "Przewodnik Tatry Zachodnie"
                    },
                    "taxClass": {
                        "description": "The tax class of the product.",
                        "type": "string",
                        "example": "printed_book"
                    },
                    "applicableVatRate": {
                        "description": "The VAT rate of the tax class today, in basis points (2300 = 23%).",
                        "type": "integer",
                        "example": 500
                    },
                    "price": {
                        "description": "The stored price, null when the product has no price yet.",
                        "nullable": true,
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/ListedPriceResponse"
                            }
                        ]
                    }
                },
                "type": "object"
            },
            "PriceListResponse": {
                "description": "A page of the price list.",
                "required": [
                    "items",
                    "next"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PriceListItemResponse"
                        }
                    },
                    "next": {
                        "description": "Opaque cursor of the next page (send it as `after`), null on the last page.",
                        "type": "string",
                        "example": "eyJuIjoiQmlkb24iLCJpIjoiMDE5MmYwYzQtN2MxYS03YzRlLTlhNmUtM2YxZDJiNGM1YTYwIn0",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "PriceHistoryItemResponse": {
                "description": "One recorded price change: the price as it was set. Amounts are in grosze, the rate in basis points; all computed by the API.",
                "required": [
                    "changedAt",
                    "currency",
                    "gross",
                    "net",
                    "vat",
                    "vatRate",
                    "taxClass",
                    "source",
                    "actorName"
                ],
                "properties": {
                    "changedAt": {
                        "description": "When the price was changed (RFC 3339, UTC).",
                        "type": "string",
                        "example": "2026-11-01T12:30:00+00:00"
                    },
                    "currency": {
                        "description": "The ISO 4217 currency code of the amounts.",
                        "type": "string",
                        "example": "PLN"
                    },
                    "gross": {
                        "description": "Gross price (VAT included) in grosze.",
                        "type": "integer",
                        "example": 5490
                    },
                    "net": {
                        "description": "Net price in grosze.",
                        "type": "integer",
                        "example": 5229
                    },
                    "vat": {
                        "description": "VAT amount in grosze (gross minus net).",
                        "type": "integer",
                        "example": 261
                    },
                    "vatRate": {
                        "description": "The VAT rate the amounts were computed at, in basis points (2300 = 23%).",
                        "type": "integer",
                        "example": 500
                    },
                    "taxClass": {
                        "description": "The tax class of the price at the time.",
                        "type": "string",
                        "example": "printed_book"
                    },
                    "source": {
                        "description": "What made the change: `staff` (a staff member in the panel), `seed` (the demo data) or `tax_reconciliation` (a repair after a rate change).",
                        "type": "string",
                        "example": "staff",
                        "enum": [
                            "staff",
                            "seed",
                            "tax_reconciliation"
                        ]
                    },
                    "actorName": {
                        "description": "The staff member who made a `staff` change, null for the other sources.",
                        "type": "string",
                        "example": "Anna Admin",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "PriceHistoryResponse": {
                "description": "A page of the price history of a product, newest change first.",
                "required": [
                    "items",
                    "next"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PriceHistoryItemResponse"
                        }
                    },
                    "next": {
                        "description": "Opaque cursor of the next page (send it as `after`), null on the last page.",
                        "type": "string",
                        "example": "eyJ0IjoiMjAyNi0xMS0wMVQxMjozMDowMC4wMDAwMDArMDA6MDAiLCJpIjoiMDE5MmYwYzQtN2MxYS03YzRlLTlhNmUtM2YxZDJiNGM1YTYwIn0",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "backoffice": {
                "type": "http",
                "description": "Access token issued by the `backoffice` realm (staff).",
