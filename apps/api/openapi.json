{
    "openapi": "3.0.3",
    "info": {
        "title": "Shop API",
        "description": "Public and customer endpoints used by the store.",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/categories": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "summary": "Category tree",
                "description": "The whole category tree. Siblings at every level are sorted by name (Polish collation).",
                "operationId": "getCategoryTree",
                "responses": {
                    "200": {
                        "description": "Root categories with their descendants. An empty catalogue gives an empty array.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryNode"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "An access token was sent and is invalid (problem details, `WWW-Authenticate: Bearer`). No token is needed.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "A token was sent and the keys of its issuer cannot be fetched (problem details without detail).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/products": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "summary": "Product list",
                "description": "A page of products sorted by name, then by id. The category filter includes the products of all its subcategories; an unknown category gives an empty list. A page past the end gives an empty list with the real total.",
                "operationId": "listProducts",
                "parameters": [
                    {
                        "name": "category",
                        "in": "query",
                        "description": "Category id (UUID).",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number, from 1.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 1,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Page size.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 24,
                            "maximum": 48,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of products.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductPage"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid query parameters (problem details with `violations`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "An access token was sent and is invalid (problem details, `WWW-Authenticate: Bearer`). No token is needed.",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "The search service is unavailable, or a token was sent and the keys of its issuer cannot be fetched (problem details without technical details).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/me": {
            "get": {
                "tags": [
                    "Customer"
                ],
                "summary": "Current customer",
                "description": "The customer identified by the access token of the `shop` realm.",
                "operationId": "getMe",
                "responses": {
                    "200": {
                        "description": "The customer.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MeResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid access token (problem details, `WWW-Authenticate: Bearer`).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "The keys of the token issuer cannot be fetched (problem details without detail).",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Problem"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "shop": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "ProductPage": {
                "required": [
                    "items",
                    "page",
                    "perPage",
                    "total"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ProductListItem"
                        }
                    },
                    "page": {
                        "description": "The requested page, from 1.",
                        "type": "integer",
                        "example": 1
                    },
                    "perPage": {
                        "description": "The requested page size.",
                        "type": "integer",
                        "example": 24
                    },
                    "total": {
                        "description": "All products matching the filter, not only this page.",
                        "type": "integer",
                        "example": 412
                    }
                },
                "type": "object"
            },
            "ProductListItem": {
                "required": [
                    "id",
                    "name",
                    "slug",
                    "shortDescription",
                    "image"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string",
                        "example": "Buty do biegania Puls 2 granatowe"
                    },
                    "slug": {
                        "type": "string",
                        "example": "buty-do-biegania-puls-2-granatowe"
                    },
                    "shortDescription": {
                        "type": "string"
                    },
                    "image": {
                        "description": "The main image, null when the product has no images.",
                        "nullable": true,
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/ProductImage"
                            }
                        ]
                    }
                },
                "type": "object"
            },
            "ProductImage": {
                "description": "A product image of one predefined size, with signed URLs of its variants grouped by output format.",
                "required": [
                    "alt",
                    "size",
                    "aspectRatio",
                    "variants"
                ],
                "properties": {
                    "alt": {
                        "description": "Alternative text of the image.",
                        "type": "string",
                        "example": "Biegaczka na le\u015bnej \u015bcie\u017cce"
                    },
                    "size": {
                        "description": "Name of the image size.",
                        "type": "string",
                        "example": "listing"
                    },
                    "aspectRatio": {
                        "description": "Aspect ratio of every variant, width:height.",
                        "type": "string",
                        "example": "1:1"
                    },
                    "variants": {
                        "description": "Variants by output format (the key is the file extension, e.g. webp), widths ascending.",
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "required": [
                                    "width",
                                    "url"
                                ],
                                "properties": {
                                    "width": {
                                        "type": "integer",
                                        "example": 256
                                    },
                                    "url": {
                                        "type": "string",
                                        "example": "http://localhost:8081/signature/rs:fill:256:256/g:sm/czM6Ly9idWNrZXQva2V5/plain.webp"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "type": "object"
            },
            "Problem": {
                "description": "Problem details (RFC 9457), `application/problem+json`.",
                "required": [
                    "type",
                    "title",
                    "status"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "example": "about:blank"
                    },
                    "title": {
                        "type": "string",
                        "example": "Bad Request"
                    },
                    "status": {
                        "type": "integer",
                        "example": 400
                    },
                    "detail": {
                        "description": "Present only for 4xx errors, never for 5xx.",
                        "type": "string"
                    },
                    "violations": {
                        "description": "Present only for 400 caused by invalid input.",
                        "type": "array",
                        "items": {
                            "required": [
                                "propertyPath",
                                "title"
                            ],
                            "properties": {
                                "propertyPath": {
                                    "type": "string",
                                    "example": "category"
                                },
                                "title": {
                                    "type": "string",
                                    "example": "This is not a valid UUID."
                                }
                            },
                            "type": "object"
                        }
                    }
                },
                "type": "object"
            },
            "ListProductsQuery": {
                "properties": {
                    "category": {
                        "type": "string",
                        "nullable": true,
                        "default": null
                    },
                    "page": {
                        "type": "integer",
                        "default": 1,
                        "minimum": 0,
                        "exclusiveMinimum": true
                    },
                    "perPage": {
                        "type": "integer",
                        "default": 24,
                        "maximum": 48,
                        "minimum": 1
                    }
                },
                "type": "object"
            },
            "CategoryNode": {
                "required": [
                    "id",
                    "name",
                    "children"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "children": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CategoryNode"
                        }
                    }
                },
                "type": "object"
            },
            "MeResponse": {
                "description": "The customer identified by the access token.",
                "required": [
                    "id",
                    "email",
                    "name"
                ],
                "properties": {
                    "id": {
                        "description": "Customer id, the `sub` of the token.",
                        "type": "string",
                        "example": "58276b79-2248-4817-8b28-5dbbb4f343ab"
                    },
                    "email": {
                        "type": "string",
                        "example": "jan.kowalski@example.com"
                    },
                    "name": {
                        "description": "Full name, empty when the account has none.",
                        "type": "string",
                        "example": "Jan Kowalski"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "shop": {
                "type": "http",
                "description": "Access token issued by the `shop` realm (customers).",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Catalog",
            "description": "Catalog"
        },
        {
            "name": "Customer",
            "description": "Customer"
        }
    ]
}
