APP_ENV=dev

# Read access to the private bucket of the demo photo pool (docs/features/demo-data/spec.md, "Zdjęcia"): only profiles of
# `make seed-scale` other than small use it, and `make seed-scale` fills these from ~/.config/shop/demo-photos.env. Empty
# here, so the application starts without them; the values never belong in this file.
DEMO_PHOTOS_ENDPOINT=
DEMO_PHOTOS_BUCKET=
DEMO_PHOTOS_ACCESS_KEY_ID=
DEMO_PHOTOS_SECRET_ACCESS_KEY=
