{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Values of the shop chart",
  "type": "object",
  "required": [
    "global",
    "image",
    "images",
    "ingress",
    "noindex",
    "demoNotice",
    "customerAccounts",
    "orderMail",
    "ipAllowList",
    "secrets",
    "mailer",
    "brevo",
    "initialize",
    "jobs",
    "cartPurge",
    "storage",
    "elasticsearch",
    "keycloak",
    "resources"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "domain",
        "scheme"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
          "description": "Base domain; required."
        },
        "scheme": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "registry",
        "tag",
        "digests",
        "requireDigests",
        "pullPolicy"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
          "not": {
            "const": "latest"
          },
          "description": "The revision (commit SHA); required, never latest."
        },
        "digests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "api",
            "store",
            "admin",
            "elasticsearch"
          ],
          "properties": {
            "api": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "store": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "admin": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "elasticsearch": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            }
          },
          "description": "Digests of the images built by us: empty or sha256:<64 hex>."
        },
        "requireDigests": {
          "type": "boolean"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "if": {
        "properties": {
          "requireDigests": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "digests": {
            "properties": {
              "api": {
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "store": {
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "admin": {
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "elasticsearch": {
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[^@\\s]+:[^@\\s:/]+@sha256:[0-9a-f]{64}$",
        "description": "name:tag@sha256:<digest of the multi-arch index>"
      },
      "required": [
        "postgres",
        "redis",
        "rabbitmq",
        "keycloak",
        "garage",
        "imgproxy",
        "mailpit",
        "varnish",
        "alpine",
        "kubectl"
      ]
    },
    "ingress": {
      "type": "object",
      "required": [
        "className",
        "tls"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "boolean"
        },
        "tlsSecretName": {
          "type": "string"
        }
      }
    },
    "noindex": {
      "type": "boolean"
    },
    "demoNotice": {
      "type": "boolean",
      "description": "The bar of a demo store (STORE_DEMO_NOTICE of the store)."
    },
    "customerAccounts": {
      "type": "boolean",
      "description": "Registration in the realm shop and the login link of the store."
    },
    "orderMail": {
      "type": "string",
      "enum": [
        "mailpit",
        "brevo"
      ],
      "description": "Where the API sends its mail: the Mailpit of the cluster or Brevo SMTP (needs brevo.secretName)."
    },
    "ipAllowList": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sourceRange": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "sourceRange"
        ],
        "properties": {
          "sourceRange": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": [
        "create",
        "name"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "create": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "values"
        ],
        "properties": {
          "values": {
            "type": "object",
            "required": [
              "POSTGRES_PASSWORD",
              "KEYCLOAK_DB_PASSWORD",
              "SHOP_DB_PASSWORD",
              "RABBITMQ_DEFAULT_PASS",
              "KC_BOOTSTRAP_ADMIN_PASSWORD",
              "GARAGE_RPC_SECRET",
              "GARAGE_ADMIN_TOKEN",
              "GARAGE_ACCESS_KEY_ID",
              "GARAGE_SECRET_ACCESS_KEY",
              "IMGPROXY_KEY",
              "IMGPROXY_SALT",
              "STORE_CLIENT_SECRET",
              "STORE_SESSION_SECRET",
              "VARNISH_PURGE_SECRET",
              "STORE_REVALIDATE_SECRET",
              "PAYMENT_DEMO_TRANSFER_API_KEY",
              "PAYMENT_DEMO_TRANSFER_WEBHOOK_SECRET",
              "PAYMENT_DEMO_CARD_API_KEY",
              "PAYMENT_DEMO_CARD_WEBHOOK_SECRET"
            ],
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "mailer": {
      "type": "object",
      "required": [
        "from"
      ],
      "properties": {
        "from": {
          "type": "string"
        }
      }
    },
    "brevo": {
      "type": "object",
      "required": [
        "host",
        "port",
        "secretName"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "secretName": {
          "type": "string",
          "description": "The Secret with BREVO_SMTP_LOGIN and BREVO_SMTP_PASSWORD; required when orderMail or keycloak.mail is brevo."
        }
      }
    },
    "initialize": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "jobs": {
      "type": "object",
      "required": [
        "backoffLimit",
        "activeDeadlineSeconds"
      ],
      "properties": {
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        }
      }
    },
    "cartPurge": {
      "type": "object",
      "required": [
        "schedule",
        "timeZone"
      ],
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "className",
        "postgres",
        "elasticsearch",
        "rabbitmq",
        "redis",
        "garageMeta",
        "garageData"
      ]
    },
    "elasticsearch": {
      "type": "object",
      "required": [
        "javaOpts"
      ],
      "properties": {
        "javaOpts": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "keycloak": {
      "type": "object",
      "required": [
        "javaHeap",
        "mail",
        "mailFrom",
        "mailFromName"
      ],
      "properties": {
        "javaHeap": {
          "type": "string",
          "minLength": 1
        },
        "mail": {
          "type": "string",
          "enum": [
            "mailpit",
            "brevo"
          ],
          "description": "The mail of the realms: the Mailpit of the cluster or Brevo SMTP (needs brevo.secretName)."
        },
        "mailFrom": {
          "type": "string"
        },
        "mailFromName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "postgres",
        "redis",
        "elasticsearch",
        "rabbitmq",
        "garage",
        "keycloak",
        "mailpit",
        "api",
        "worker",
        "store",
        "admin",
        "imgproxy",
        "varnish",
        "job"
      ],
      "properties": {
        "postgres": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "redis": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "elasticsearch": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "rabbitmq": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "garage": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "keycloak": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "mailpit": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "api": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "worker": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "store": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "admin": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "imgproxy": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "varnish": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "job": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "orderMail"
        ],
        "properties": {
          "orderMail": {
            "const": "brevo"
          }
        }
      },
      "then": {
        "properties": {
          "brevo": {
            "properties": {
              "secretName": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "keycloak"
        ],
        "properties": {
          "keycloak": {
            "required": [
              "mail"
            ],
            "properties": {
              "mail": {
                "const": "brevo"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "brevo": {
            "properties": {
              "secretName": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
