            ],
            "properties": {
              "requireDigests": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "clientIpHeaderWithoutAllowList": {
            "const": false,
            "description": "Never with the images of a release (image.requireDigests)."
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "image",
          "demoData"
        ],
        "properties": {
          "image": {
            "required": [
              "requireDigests"
            ],
            "properties": {
              "requireDigests": {
                "const": true
              }
            }
          },
          "demoData": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "demoData": {
            "description": "With the images of a release (the server): the generator of the steps of docs/features/demo-scale/spec.md.",
            "properties": {
              "profile": {
                "enum": [
                  "medium",
                  "server"
                ],
                "description": "With the images of a release only medium or server (docs/features/demo-scale/spec.md, U2)."
              },
              "anchor": {
                "minLength": 1,
                "description": "With the images of a release a fixed anchor, so that a run again gives the same data."
              },
              "photosSecretName": {
                "minLength": 1,
                "description": "With the images of a release the Secret of the photo pool (the profiles medium and server need it)."
              },
              "minFreeGb": {
                "minimum": 10,
                "description": "With the images of a release a floor of at least 10 GB of the free space of the node."
              }
            }
          }
        }
      }
    }
