          "clientIpHeader": {
            "minLength": 1
          },
          "ipAllowList": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "clientIpHeaderWithoutAllowList"
        ],
        "properties": {
          "clientIpHeaderWithoutAllowList": {
            "const": true,
            "description": "clientIpHeader without ipAllowList: anybody could set the address of the client."
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "required": [
