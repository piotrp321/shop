{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Values of the shop chart",
  "type": "object",
  "required": [
    "global",
    "image",
    "images",
    "ingress",
    "noindex",
    "demoNotice",
    "customerAccounts",
    "orderMail",
    "ipAllowList",
    "clientIpHeader",
    "clientIpHeaderWithoutAllowList",
    "sentry",
    "secrets",
    "mailer",
    "brevo",
    "initialize",
    "jobs",
    "demoData",
    "load",
    "backup",
    "alerts",
    "cartPurge",
    "rateLimitCheck",
    "queueCheck",
    "orderExpiry",
    "storage",
    "reindex",
    "elasticsearch",
    "keycloak",
    "resources"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "domain",
        "scheme"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$",
          "description": "Base domain; required."
        },
        "scheme": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "registry",
        "tag",
        "digests",
        "requireDigests",
        "pullPolicy"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
          "not": {
            "const": "latest"
          },
          "description": "The revision (commit SHA); required, never latest."
        },
        "digests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "api",
            "store",
            "admin",
            "elasticsearch"
          ],
          "properties": {
            "api": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "store": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "admin": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            },
            "elasticsearch": {
              "type": "string",
              "pattern": "^(sha256:[0-9a-f]{64})?$"
            }
          },
          "description": "Digests of the images built by us: empty or sha256:<64 hex>."
        },
        "requireDigests": {
          "type": "boolean"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "if": {
        "properties": {
          "requireDigests": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "digests": {
            "properties": {
              "api": {
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "store": {
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "admin": {
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "elasticsearch": {
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[^@\\s]+:[^@\\s:/]+@sha256:[0-9a-f]{64}$",
        "description": "name:tag@sha256:<digest of the multi-arch index>"
      },
      "required": [
        "postgres",
        "redis",
        "rabbitmq",
        "keycloak",
        "garage",
        "imgproxy",
        "mailpit",
        "varnish",
        "alpine",
        "kubectl",
        "restic",
        "rclone",
        "k6"
      ]
    },
    "ingress": {
      "type": "object",
      "required": [
        "className",
        "tls"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "boolean"
        },
        "tlsSecretName": {
          "type": "string"
        }
      }
    },
    "noindex": {
      "type": "boolean"
    },
    "demoNotice": {
      "type": "boolean",
      "description": "The bar of a demo store (STORE_DEMO_NOTICE of the store)."
    },
    "customerAccounts": {
      "type": "boolean",
      "description": "Registration in the realm shop and the login link of the store."
    },
    "orderMail": {
      "type": "string",
      "enum": [
        "mailpit",
        "brevo"
      ],
      "description": "Where the API sends its mail: the Mailpit of the cluster or Brevo SMTP (needs brevo.secretName)."
    },
    "ipAllowList": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sourceRange": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "sourceRange"
        ],
        "properties": {
          "sourceRange": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "clientIpHeader": {
      "type": "string",
      "pattern": "^([A-Za-z0-9-]+)?$",
      "description": "The header with the address of the client (CLIENT_IP_HEADER of the api and the store); empty: none. Needs ipAllowList, or clientIpHeaderWithoutAllowList."
    },
    "clientIpHeaderWithoutAllowList": {
      "type": "boolean",
      "description": "Confirms clientIpHeader without ipAllowList (the measurement on a local cluster); never with image.requireDigests."
    },
    "sentry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "tracesSampleRate",
        "dsn"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]*$",
          "maxLength": 64,
          "description": "SENTRY_ENVIRONMENT of an application with a DSN; empty: the application's own default."
        },
        "tracesSampleRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "SENTRY_TRACES_SAMPLE_RATE: the share of the traced transactions, 0 to 1."
        },
        "dsn": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "api",
            "store",
            "admin"
          ],
          "properties": {
            "api": {
              "type": "string",
              "pattern": "^(https://[A-Za-z0-9]+@[A-Za-z0-9.-]+(:[0-9]+)?/[0-9]+)?$",
              "description": "DSN of the api, the workers and the jobs: https://<key>@<host>/<project id>; empty: Sentry off."
            },
            "store": {
              "type": "string",
              "pattern": "^(https://[A-Za-z0-9]+@[A-Za-z0-9.-]+(:[0-9]+)?/[0-9]+)?$",
              "description": "DSN of the store (its server and its browser); empty: Sentry off."
            },
            "admin": {
              "type": "string",
              "pattern": "^(https://[A-Za-z0-9]+@[A-Za-z0-9.-]+(:[0-9]+)?/[0-9]+)?$",
              "description": "DSN of the admin panel; empty: Sentry off."
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "required": [
        "create",
        "name"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "create": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "values"
        ],
        "properties": {
          "values": {
            "type": "object",
            "required": [
              "POSTGRES_PASSWORD",
              "KEYCLOAK_DB_PASSWORD",
              "SHOP_DB_PASSWORD",
              "RABBITMQ_DEFAULT_PASS",
              "KC_BOOTSTRAP_ADMIN_PASSWORD",
              "GARAGE_RPC_SECRET",
              "GARAGE_ADMIN_TOKEN",
              "GARAGE_ACCESS_KEY_ID",
              "GARAGE_SECRET_ACCESS_KEY",
              "IMGPROXY_KEY",
              "IMGPROXY_SALT",
              "STORE_CLIENT_SECRET",
              "STORE_SESSION_SECRET",
              "VARNISH_PURGE_SECRET",
              "STORE_REVALIDATE_SECRET",
              "PAYMENT_DEMO_TRANSFER_API_KEY",
              "PAYMENT_DEMO_TRANSFER_WEBHOOK_SECRET",
              "PAYMENT_DEMO_CARD_API_KEY",
              "PAYMENT_DEMO_CARD_WEBHOOK_SECRET"
            ],
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "mailer": {
      "type": "object",
      "required": [
        "from"
      ],
      "properties": {
        "from": {
          "type": "string"
        }
      }
    },
    "brevo": {
      "type": "object",
      "required": [
        "host",
        "port",
        "secretName"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "secretName": {
          "type": "string",
          "description": "The Secret with BREVO_SMTP_LOGIN and BREVO_SMTP_PASSWORD; required when orderMail or keycloak.mail is brevo."
        }
      }
    },
    "initialize": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "jobs": {
      "type": "object",
      "required": [
        "backoffLimit",
        "activeDeadlineSeconds",
        "backfillActiveDeadlineSeconds"
      ],
      "properties": {
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "backfillActiveDeadlineSeconds": {
          "type": "integer",
          "minimum": 60,
          "description": "The deadline of the job backfill (app:backfill), which runs longer than the other jobs of a version."
        }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Render the PrometheusRule with the alert rules (needs the CRD of the Prometheus Operator in the cluster)."
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeDeadlineSeconds"
      ],
      "properties": {
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60,
          "description": "The time limit of a Job of the CronJob load, in seconds."
        }
      }
    },
    "demoData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "profile",
        "anchor",
        "activeDeadlineSeconds",
        "photosSecretName",
        "minFreeGb",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Render the suspended CronJob demo-data (the profiles prod, ci and load)."
        },
        "profile": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "server",
            "full"
          ],
          "description": "The profile of the generator (apps/api/fixtures/demo-data/profiles.yaml)."
        },
        "anchor": {
          "type": "string",
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?)?$",
          "description": "--anchor of the generator: a date or a UTC moment; empty: the start of the current UTC day."
        },
        "activeDeadlineSeconds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "small",
            "medium",
            "server",
            "full"
          ],
          "properties": {
            "small": {
              "type": "integer",
              "minimum": 60
            },
            "medium": {
              "type": "integer",
              "minimum": 60
            },
            "server": {
              "type": "integer",
              "minimum": 60
            },
            "full": {
              "type": "integer",
              "minimum": 60
            }
          },
          "description": "The time limit of a Job in seconds, per profile of the generator."
        },
        "photosSecretName": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
          "maxLength": 253,
          "description": "The Secret with the four DEMO_PHOTOS_* read variables of the photo pool, created outside the chart; empty: none."
        },
        "minFreeGb": {
          "type": "integer",
          "minimum": 1,
          "description": "The floor of the free space of the node in GB: the script does not start below it and stops the generator under it."
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 60,
          "description": "The seconds after TERM in which the script stops the generator (TERM, KILL after 30 s) and writes its summary."
        }
      }
    },
    "backup": {
      "type": "object",
      "required": [
        "enabled",
        "schedule",
        "verifySchedule",
        "verifyReadData",
        "timeZone",
        "retention",
        "repository",
        "s3Region",
        "secretName"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "verifySchedule": {
          "type": "string",
          "minLength": 1
        },
        "verifyReadData": {
          "enum": [
            "subset",
            "all"
          ],
          "description": "What restic check reads in the verification: subset (the seventh of the data numbered by the day of the week) or all."
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "string",
          "pattern": "^([0-9]+[ymdh])+$",
          "description": "restic duration for forget --keep-within, e.g. 7d."
        },
        "repository": {
          "type": "string",
          "description": "The restic repository (s3:https://<host>/<bucket>); required when enabled."
        },
        "s3Region": {
          "type": "string"
        },
        "secretName": {
          "type": "string",
          "description": "The Secret with RESTIC_PASSWORD, BACKUP_S3_ACCESS_KEY_ID and BACKUP_S3_SECRET_ACCESS_KEY; required when enabled."
        },
        "secretValues": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "secretName": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cartPurge": {
      "type": "object",
      "required": [
        "schedule",
        "timeZone"
      ],
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rateLimitCheck": {
      "type": "object",
      "required": [
        "schedule"
      ],
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "queueCheck": {
      "type": "object",
      "required": [
        "schedule",
        "timeZone"
      ],
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "orderExpiry": {
      "type": "object",
      "required": [
        "schedule",
        "timeZone"
      ],
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "storage": {
      "type": "object",
      "required": [
        "className",
        "postgres",
        "elasticsearch",
        "rabbitmq",
        "redis",
        "garageMeta",
        "garageData",
        "backupWork"
      ]
    },
    "elasticsearch": {
      "type": "object",
      "required": [
        "javaOpts",
        "shards",
        "refreshInterval"
      ],
      "properties": {
        "javaOpts": {
          "type": "string",
          "minLength": 1
        },
        "shards": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "description": "The primary shards of a new product index (SEARCH_SHARDS); Elasticsearch allows at most 1024."
        },
        "refreshInterval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s)$",
          "description": "The refresh interval of the product index (SEARCH_REFRESH_INTERVAL): a whole number with the unit ms or s."
        }
      }
    },
    "keycloak": {
      "type": "object",
      "required": [
        "javaHeap",
        "mail",
        "mailFrom",
        "mailFromName"
      ],
      "properties": {
        "javaHeap": {
          "type": "string",
          "minLength": 1
        },
        "mail": {
          "type": "string",
          "enum": [
            "mailpit",
            "brevo"
          ],
          "description": "The mail of the realms: the Mailpit of the cluster or Brevo SMTP (needs brevo.secretName)."
        },
        "mailFrom": {
          "type": "string"
        },
        "mailFromName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "postgres",
        "redis",
        "elasticsearch",
        "rabbitmq",
        "garage",
        "keycloak",
        "mailpit",
        "api",
        "worker",
        "workerCommands",
        "store",
        "admin",
        "imgproxy",
        "varnish",
        "backup",
        "job",
        "demoData",
        "k6"
      ],
      "properties": {
        "postgres": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "redis": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "elasticsearch": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "rabbitmq": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "garage": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "keycloak": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "mailpit": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "api": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "worker": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "workerCommands": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "store": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "admin": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "imgproxy": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "varnish": {
          "type": "object",
          "required": [
            "requests"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "backup": {
          "type": "object",
          "required": [
