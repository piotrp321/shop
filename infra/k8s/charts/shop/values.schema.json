        }
      }
    },
    {
      "if": {
        "required": [
          "keycloak"
        ],
        "properties": {
          "keycloak": {
            "required": [
              "mail"
            ],
            "properties": {
              "mail": {
                "const": "brevo"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "brevo": {
            "properties": {
              "secretName": {
                "minLength": 1
              }
            }
          }
        }
      }
