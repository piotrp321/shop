varnishtest "PURGE with the token removes only the objects with the given tags and never reaches the API"

# Every request the backend gets is listed here; a PURGE forwarded to the API would break the sequence.
server s1 -listen 127.0.0.1:80 {
	rxreq
	expect req.url == "/api/v1/products/a"
	txresp -hdr "Cache-Control: max-age=60, public" -hdr "xkey: catalog product-a" -body "a1"
	rxreq
	expect req.url == "/api/v1/products/b"
	txresp -hdr "Cache-Control: max-age=60, public" -hdr "xkey: catalog product-b" -body "b1"
	rxreq
	expect req.url == "/api/v1/product-offers?productId=a&productId=b"
	txresp -hdr "Cache-Control: max-age=60, public" -hdr "xkey: catalog product-a product-b" -body "ab1"
	rxreq
	expect req.url == "/api/v1/categories"
	txresp -hdr "Cache-Control: max-age=60, public" -hdr "xkey: catalog" -body "c1"
	# After the purge of product-a: only a and the offers of a and b are fetched again.
	rxreq
	expect req.method == "GET"
	expect req.url == "/api/v1/products/a"
	txresp -hdr "Cache-Control: max-age=60, public" -hdr "xkey: catalog product-a" -body "a2"
	rxreq
	expect req.method == "GET"
	expect req.url == "/api/v1/product-offers?productId=a&productId=b"
	txresp -hdr "Cache-Control: max-age=60, public" -hdr "xkey: catalog product-a product-b" -body "ab2"
	# After the purge of catalog: everything.
	rxreq
	expect req.method == "GET"
	expect req.url == "/api/v1/categories"
	txresp -hdr "Cache-Control: max-age=60, public" -hdr "xkey: catalog" -body "c2"
} -start

setenv VARNISH_PURGE_SECRET "s3cret"
varnish v1 -arg "-t 0" -cliok "vcl.load main /etc/varnish/default.vcl" -cliok "vcl.use main" -start

client c1 {
	txreq -url "/api/v1/products/a"
	rxresp
	txreq -url "/api/v1/products/b"
	rxresp
	txreq -url "/api/v1/product-offers?productId=a&productId=b"
	rxresp
	txreq -url "/api/v1/categories"
	rxresp
	expect resp.http.X-Cache == "MISS"

	txreq -req PURGE -url "/" -hdr "xkey-purge: product-a" -hdr "X-Purge-Token: s3cret"
	rxresp
	expect resp.status == 200
	expect resp.reason == "Purged 2"
	expect resp.http.xkey == <undef>

	txreq -url "/api/v1/products/a"
	rxresp
	expect resp.body == "a2"
	expect resp.http.X-Cache == "MISS"
	txreq -url "/api/v1/product-offers?productId=a&productId=b"
	rxresp
	expect resp.body == "ab2"
	expect resp.http.X-Cache == "MISS"
	txreq -url "/api/v1/products/b"
	rxresp
	expect resp.body == "b1"
	expect resp.http.X-Cache == "HIT"
	txreq -url "/api/v1/categories"
	rxresp
	expect resp.body == "c1"
	expect resp.http.X-Cache == "HIT"

	# A tag no object has: nothing removed.
	txreq -req PURGE -url "/" -hdr "xkey-purge: product-unknown" -hdr "X-Purge-Token: s3cret"
	rxresp
	expect resp.status == 200
	expect resp.reason == "Purged 0"
	txreq -url "/api/v1/products/b"
	rxresp
	expect resp.http.X-Cache == "HIT"

	# Several tags in one header. xkey counts per tag: catalog 4 objects, product-b 2 of them.
	txreq -req PURGE -url "/" -hdr "xkey-purge: catalog product-b" -hdr "X-Purge-Token: s3cret"
	rxresp
	expect resp.status == 200
	expect resp.reason == "Purged 6"
	txreq -url "/api/v1/categories"
	rxresp
	expect resp.body == "c2"
	expect resp.http.X-Cache == "MISS"
} -run

varnish v1 -expect backend_req == 7
