varnishtest "PURGE without the token or with a wrong one is 403, without xkey-purge 400; nothing is removed"

server s1 -listen 127.0.0.1:80 {
	rxreq
	expect req.url == "/api/v1/products/a"
	txresp -hdr "Cache-Control: max-age=60, public" -hdr "xkey: catalog product-a" -body "a1"
} -start

setenv VARNISH_PURGE_SECRET "s3cret"
varnish v1 -arg "-t 0" -cliok "vcl.load main /etc/varnish/default.vcl" -cliok "vcl.use main" -start

client c1 {
	txreq -url "/api/v1/products/a"
	rxresp
	expect resp.http.X-Cache == "MISS"

	txreq -req PURGE -url "/" -hdr "xkey-purge: product-a"
	rxresp
	expect resp.status == 403

	txreq -req PURGE -url "/" -hdr "xkey-purge: product-a" -hdr "X-Purge-Token: wrong"
	rxresp
	expect resp.status == 403

	txreq -req PURGE -url "/" -hdr "xkey-purge: product-a" -hdr "X-Purge-Token: s3cret-and-more"
	rxresp
	expect resp.status == 403

	txreq -req PURGE -url "/" -hdr "xkey-purge: product-a" -hdr "X-Purge-Token: "
	rxresp
	expect resp.status == 403

	# A valid token, but no tags.
	txreq -req PURGE -url "/" -hdr "X-Purge-Token: s3cret"
	rxresp
	expect resp.status == 400

	txreq -req PURGE -url "/" -hdr "xkey-purge: " -hdr "X-Purge-Token: s3cret"
	rxresp
	expect resp.status == 400

	# Still cached: no PURGE above removed anything, and none reached the API.
	txreq -url "/api/v1/products/a"
	rxresp
	expect resp.body == "a1"
	expect resp.http.X-Cache == "HIT"
} -run

varnish v1 -expect backend_req == 1
