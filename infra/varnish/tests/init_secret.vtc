varnishtest "vcl_init fails without VARNISH_PURGE_SECRET or with an empty one"

# The child runs with a trivial VCL; loading default.vcl runs its vcl_init, which must fail.
varnish v1 -vcl {backend none none;} -start

# Not set at all (the test runner passes no environment).
varnish v1 -clierr 300 "vcl.load unset /etc/varnish/default.vcl"
varnish v1 -cliexpect "VARNISH_PURGE_SECRET is not set" "vcl.load unset2 /etc/varnish/default.vcl"

# Set, but empty: a separate manager, because the environment is read when varnishd starts.
setenv VARNISH_PURGE_SECRET ""
varnish v2 -vcl {backend none none;} -start
varnish v2 -clierr 300 "vcl.load empty /etc/varnish/default.vcl"
varnish v2 -cliexpect "VARNISH_PURGE_SECRET is not set" "vcl.load empty2 /etc/varnish/default.vcl"

# With a secret the same file loads.
setenv VARNISH_PURGE_SECRET "s3cret"
varnish v3 -vcl {backend none none;} -start
varnish v3 -cliok "vcl.load set /etc/varnish/default.vcl"
